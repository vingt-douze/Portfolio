{
  "name": "portfolio-new",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run next\" \"pnpm run storybook\" \"pnpm run typesafe-i18n\" --kill-others",
    "next": "next dev --turbopack -p 8060",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint src .storybook next.config.ts",
    "storybook": "storybook dev -p 6006 --no-open --quiet",
    "build-storybook": "storybook build",
    "typesafe-i18n": "typesafe-i18n"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
