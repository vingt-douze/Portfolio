    "@types/bcryptjs": "^2.4.6",
    "@vercel/analytics": "^1.6.1",
    "@vercel/kv": "^3.0.0",
    "ai": "^4.3.19",
    "bcryptjs": "^2.4.3",
    "localforage": "^1.10.0",
    "motion": "^11.18.2",
    "next": "15.5.28",
    "openai": "^4.104.0",
    "overlayscrollbars": "^2.17.0",
    "overlayscrollbars-react": "^0.5.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^4.8.0",
    "sass": "^1.106.0",
    "sass-loader": "^16.0.8",
    "typesafe-i18n": "^5.27.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
