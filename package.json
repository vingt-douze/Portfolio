    "@storybook/addon-onboarding": "^10.6.3",
    "@storybook/nextjs": "^10.6.3",
    "@storybook/react": "^10.6.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "^9.2.5",
    "storybook": "^10.6.3",
    "typescript": "^5.9.3"
  }
